{
  "name": "techeverri",
  "version": "1.8.0",
  "description": "Personal card for Tomas Echeverri (@techeverri)",
  "keywords": [
    "business card",
    "card",
    "npm",
    "npm card",
    "npx",
    "npx card",
    "techeverri"
  ],
  "license": "MIT",
  "author": {
    "name": "Tomas Echeverri",
    "url": "https://github.com/techeverri"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/techeverri/techeverri-cli.git"
  },
  "bin": "./bin/cli.js",
  "files": [
    "bin/card"
  ],
  "type": "module",
  "main": "./bin/cli.js",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "print": "bun run ./bin/cli.js",
    "build": "bun run ./build.js",
    "postbuild": "bun run print"
  },
  "devDependencies": {
    "boxen": "^8.0.0",
    "chalk": "^5.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0"
  },
  "preferGlobal": true,
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=16"
  },
  "packageManager": "bun@1.4.3"
}
