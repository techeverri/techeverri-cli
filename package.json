{
  "name": "techeverri",
  "version": "1.10.0",
  "description": "Tomas Echeverri's terminal business card — run npx techeverri",
  "keywords": [
    "business card",
    "card",
    "npm card",
    "npx card",
    "techeverri"
  ],
  "license": "MIT",
  "author": {
    "name": "Tomas Echeverri",
    "url": "https://github.com/techeverri"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/techeverri/techeverri-cli.git"
  },
  "bin": "./bin/cli.js",
  "files": [
    "bin"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "print": "bun run ./bin/cli.js",
    "screenshot": "sh screenshot.sh",
    "build": "bun run build.js",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "chalk": "^6.0.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.3"
}
